---
// Oversigt over alle guides, sorteret efter 'order'
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Base
  title="All guides — The Gentle AI Guide"
  description="Every guide on The Gentle AI Guide: AI explained in plain English, at your own pace."
>
  <section class="section section--hero">
    <div class="inner">
      <p class="eyebrow">The guides</p>
      <h1>All five guides</h1>
      <p class="lede">In the order we suggest reading them — but any of them stands on its own.</p>
    </div>
  </section>

  <section class="section">
    <div class="inner">
      <div class="cards">
        {guides.map((guide, i) => (
          <a class="card" href={`/guides/${guide.id}/`}>
            <span class="num">{i + 1}</span>
            {guide.data.label && <span class="label" style="margin-left:0.6rem">{guide.data.label}</span>}
            <h3>{guide.data.title}</h3>
            <p>{guide.data.description}</p>
            <span class="card-cta">Read the guide →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
