---
// Alle artikler, samlet kategori for kategori
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, isPublished } from '../../site';
const all = (await getCollection('guides', isPublished)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="All articles — The Gentle AI Guide" description="Every article on The Gentle AI Guide, section by section.">
  <div class="wrap page-top">
    <h1>All articles</h1>
    <p>{all.length} articles, section by section. New to AI? Start with <a href="/guides/what-is-ai/">What is AI, actually?</a></p>
  </div>
  {CATEGORIES.map((cat) => {
    const items = all.filter((a) => a.data.category === cat.name);
    if (items.length === 0) return null;
    return (
      <section class="wrap section" aria-label={cat.name}>
        <div class="section-head"><h2>{cat.name}</h2><p>{cat.blurb}</p></div>
        <div class="grid">{items.map((a) => <ArticleCard article={a} />)}</div>
      </section>
    );
  })}
  <div style="height:3rem"></div>
</Base>
