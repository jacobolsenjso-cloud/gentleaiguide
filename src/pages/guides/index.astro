---
// Oversigt over alle guides som kort i tre spalter, sorteret efter 'order'
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Base
  title="All guides — The Gentle AI Guide"
  description="Every guide on The Gentle AI Guide: AI explained in plain English, at your own pace."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">The guides</p>
      <h1>All five guides</h1>
      <p class="lede">In the order we suggest reading them — but any of them stands on its own.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid">
        {guides.map((guide, i) => <GuideCard guide={guide} index={i} />)}
      </div>
    </div>
  </section>
</Base>
