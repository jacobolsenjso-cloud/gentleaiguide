---
// Oversigt: de fem guides som nummererede trin.
import Base from '../../layouts/Base.astro';
import Steps from '../../components/Steps.astro';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="The five guides — The Gentle AI Guide"
  description="Every guide on The Gentle AI Guide, in the order we suggest reading them."
>
  <section class="page-top">
    <div class="wrap">
      <h1>The five guides</h1>
      <p class="lede">In the order we suggest reading them. Each one takes five to ten minutes.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <Steps guides={guides} />
    </div>
  </section>
</Base>
