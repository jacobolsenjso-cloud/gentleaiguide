---
// Én side pr. artikel: kategori, titel, uddrag, meta, billede, tekst —
// og "Read next" med tre andre artikler fra samme kategori nederst.
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Blob from '../../components/Blob.astro';
import { getCollection, render } from 'astro:content';
import { categoryByName, readingMinutes, formatDate, isPublished } from '../../site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content } = await render(guide);
const cat = categoryByName(guide.data.category);
const all = (await getCollection('guides', isPublished)).sort((a, b) => a.data.order - b.data.order);
const same = all.filter((a) => a.id !== guide.id && a.data.category === guide.data.category);
const others = all.filter((a) => a.id !== guide.id && a.data.category !== guide.data.category);
const next = [...same, ...others].slice(0, 3);
const spot = guide.data.image ? guide.data.image.replace(/\.png$/, '-spot.png') : null;

// Strukturerede data for artiklen: Article (hvad den er, hvem der står bag,
// hvornår den er opdateret) + brødkrummer (Home → kategori → artikel).
// Forfatteren er sitet som organisation — der er ingen navngiven journalist,
// og vi påstår ikke andet. "Written with AI's help, checked by a person" står
// synligt i teksten ovenfor; skemaet gentager det ikke, men lyver heller ikke.
const pageUrl = `https://gentleaiguide.com/guides/${guide.id}/`;
const articleSchema = {
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  mainEntityOfPage: pageUrl,
  headline: guide.data.title,
  description: guide.data.summary ?? guide.data.description,
  image: guide.data.image ? [`https://gentleaiguide.com${guide.data.image}`] : undefined,
  datePublished: guide.data.updated.toISOString(),
  dateModified: guide.data.updated.toISOString(),
  author: { '@id': 'https://gentleaiguide.com/#organization' },
  publisher: { '@id': 'https://gentleaiguide.com/#organization' },
  inLanguage: 'en',
  articleSection: guide.data.category,
  isAccessibleForFree: true,
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://gentleaiguide.com/' },
    ...(cat ? [{ '@type': 'ListItem', position: 2, name: cat.name, item: `https://gentleaiguide.com/category/${cat.slug}/` }] : []),
    { '@type': 'ListItem', position: cat ? 3 : 2, name: guide.data.title, item: pageUrl },
  ],
};
---
<Base title={`${guide.data.seoTitle ?? guide.data.title} | Gentle AI Guide`} description={guide.data.summary ?? guide.data.description} image={guide.data.image} noindex={guide.data.draft === true} schema={[articleSchema, breadcrumbSchema]}>
  {guide.data.draft && <p class="draft-banner">Draft — not yet published. Only people with this link can see it.</p>}
  <article class="article">
    {cat && <a class="kicker" href={`/category/${cat.slug}/`}>{cat.name}</a>}
    <h1>{guide.data.title}</h1>
    <p class="lede">{guide.data.description}</p>
    <p class="meta">{formatDate(guide.data.updated)} · {readingMinutes(guide.body)} min read · Written with AI's help, checked by a person</p>
    {guide.data.figure === 'scene'
      ? guide.data.image && <img class="article-image" src={guide.data.image} alt="" width="1024" height="640" loading="eager" />
      : spot && <div class="article-fig"><Blob index={guide.data.order} /><img src={spot} alt="" width="800" height="800" loading="eager" /></div>}
    <div class="prose"><Content /></div>
  </article>
  <section class="wrap read-next" aria-label="Read next">
    <h2>Read next</h2>
    <div class="grid grid--3">{next.map((a) => <ArticleCard article={a} />)}</div>
  </section>
</Base>
