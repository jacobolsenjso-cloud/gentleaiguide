---
// Én side pr. artikel: kategori, titel, uddrag, meta, billede, tekst —
// og "Read next" med tre andre artikler fra samme kategori nederst.
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render } from 'astro:content';
import { categoryByName, readingMinutes, formatDate } from '../../site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content } = await render(guide);
const cat = categoryByName(guide.data.category);
const all = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const same = all.filter((a) => a.id !== guide.id && a.data.category === guide.data.category);
const others = all.filter((a) => a.id !== guide.id && a.data.category !== guide.data.category);
const next = [...same, ...others].slice(0, 3);
---
<Base title={`${guide.data.title} — The Gentle AI Guide`} description={guide.data.description} image={guide.data.image}>
  <article class="article">
    {cat && <a class="kicker" href={`/category/${cat.slug}/`}>{cat.name}</a>}
    <h1>{guide.data.title}</h1>
    <p class="lede">{guide.data.description}</p>
    <p class="meta">{formatDate(guide.data.updated)} · {readingMinutes(guide.body)} min read · Written with AI's help, checked by a person</p>
    {guide.data.image && <img class="article-image" src={guide.data.image} alt="" width="1024" height="640" loading="eager" />}
    <div class="prose"><Content /></div>
  </article>
  <section class="wrap read-next" aria-label="Read next">
    <h2>Read next</h2>
    <div class="grid grid--3">{next.map((a) => <ArticleCard article={a} />)}</div>
  </section>
</Base>
