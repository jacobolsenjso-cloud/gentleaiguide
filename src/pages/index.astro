---
// Forsiden (avis-opsætning): to store historier + "Latest"-spalte,
// derefter én række pr. kategori, og et bånd om hvordan sitet virker.
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../site';

const all = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
// Fremhævede: dem med featured: true (ellers de to første)
let featured = all.filter((a) => a.data.featured).slice(0, 2);
if (featured.length < 2) featured = [...featured, ...all.filter((a) => !featured.includes(a))].slice(0, 2);
// "Latest": nyeste først (efter dato, så efter nummer), uden de fremhævede
const latest = [...all]
  .filter((a) => !featured.includes(a))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime() || b.data.order - a.data.order)
  .slice(0, 7);
---
<Base
  title="The Gentle AI Guide — plain-English help with AI for people over 50"
  description="AI explained calmly, in plain English, one article at a time. Scams to recognise, tools explained, everyday uses that work — all reviewed by a person before publishing. No account, nothing to install."
>
  <div class="wrap front">
    <section aria-label="Featured articles">
      <div class="featured">
        {featured.map((a) => <ArticleCard article={a} size="big" />)}
      </div>
    </section>
    <aside aria-label="Latest articles">
      <p class="side-head">Latest</p>
      <div class="latest">
        {latest.map((a) => <ArticleCard article={a} size="row" />)}
      </div>
    </aside>
  </div>

  {CATEGORIES.map((cat) => {
    const items = all.filter((a) => a.data.category === cat.name);
    if (items.length === 0) return null;
    return (
      <section class="wrap section" aria-label={cat.name}>
        <div class="section-head">
          <h2>{cat.name}</h2>
          <p>{cat.blurb}</p>
          <a class="more" href={`/category/${cat.slug}/`}>All {cat.name.toLowerCase()} →</a>
        </div>
        <div class="grid">
          {items.slice(0, 4).map((a) => <ArticleCard article={a} />)}
        </div>
      </section>
    );
  })}

  <section class="band" aria-label="How this site works">
    <div class="wrap">
      <h2>How this site works</h2>
      <div class="band-cols">
        <div><h3>Written for people over 50</h3><p>Plain English. Every technical word explained the first time it appears. No hype, no fear.</p></div>
        <div><h3>Reviewed by a person</h3><p>Articles are drafted with AI's help, then read, corrected and approved by a human before they go online. Each one shows the date it was last checked.</p></div>
        <div><h3>Nothing to buy</h3><p>No account, no app, no newsletter you didn't ask for. If you have a question, <a href="mailto:hello@gentleaiguide.com">write to us</a> — questions often become articles.</p></div>
      </div>
    </div>
  </section>
</Base>
