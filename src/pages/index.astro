---
// Forsiden (magasin-opsætning): centreret velkomst, de fem guides som kort i
// tre spalter, og et afsnit om hvad der gør sitet anderledes.
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => a.data.order - b.data.order
);
const first = guides[0];
---
<Base
  title="The Gentle AI Guide — plain-English help with AI"
  description="AI explained calmly and in plain English, one small step at a time. No jargon, no hype, no account needed. Written for people who didn't grow up with computers."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Plain-English help with AI</p>
      <h1>AI, explained <em>gently.</em></h1>
      <p class="lede">
        Everyone talks about AI. Very few people explain it calmly. This site does —
        one small step at a time, with no jargon and no hype.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={`/guides/${first.id}/`}>Start with guide 1</a>
        <a class="btn btn--line" href="/guides/">See all five guides</a>
      </div>
      <div class="strip">
        <span><b>5</b> short guides</span>
        <span><b>0</b> accounts to create</span>
        <span><b>Every page</b> reviewed by a person</span>
        <span><b>Plain English</b> throughout</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Start with these five guides</h2>
          <p>Read them in order, or jump straight to the one that answers your question.</p>
        </div>
        <a class="btn btn--line btn--small" href="/guides/">All guides →</a>
      </div>
      <div class="grid">
        {guides.map((guide, i) => <GuideCard guide={guide} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section section--card">
    <div class="wrap why-cols">
      <div>
        <p class="eyebrow">Why this site is different</p>
        <h2>We assume nothing, and we never make you feel behind.</h2>
        <p>
          Every guide is written with the help of AI and then read, corrected and
          approved by a person before it is published. Each page shows the date it
          was last checked.
        </p>
        <p>
          That's the working relationship we recommend you have with AI, too: let it
          do the heavy lifting, but never let it have the final word.
        </p>
        <div class="btn-row">
          <a class="btn btn--line" href="/about/">More about how this works</a>
        </div>
      </div>
      <ul class="checks">
        <li>Written for people who didn't grow up with computers</li>
        <li>Every technical word explained the first time it appears</li>
        <li>Nothing to buy, no account, nothing to install</li>
        <li>Each page shows when a person last checked it</li>
      </ul>
    </div>
  </section>
</Base>
