---
// Forsiden: todelt velkomst med illustration, de fem guides som kort i tre
// spalter, og tre fliser om hvad der gør sitet anderledes.
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => a.data.order - b.data.order
);
const first = guides[0];
---
<Base
  title="The Gentle AI Guide — plain-English help with AI"
  description="AI explained calmly and in plain English, one small step at a time. No jargon, no hype, no account needed. Written for people who didn't grow up with computers."
>
  <section class="hero">
    <div class="wrap hero-cols">
      <div>
        <p class="eyebrow">Plain-English help with AI</p>
        <h1>AI, explained gently.</h1>
        <p class="lede">
          Everyone talks about AI. Very few people explain it calmly. This site does —
          one small step at a time, with no jargon and no hype.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={`/guides/${first.id}/`}>Start with guide 1</a>
          <a class="btn btn--line" href="/guides/">See all five guides</a>
        </div>
      </div>
      <div class="illus" aria-hidden="true">
        <svg viewBox="0 0 400 340" xmlns="http://www.w3.org/2000/svg">
          <circle cx="300" cy="90" r="70" fill="#f2a33c" opacity="0.9"/>
          <rect x="60" y="150" width="220" height="120" rx="28" fill="#fff"/>
          <rect x="90" y="185" width="140" height="14" rx="7" fill="#2a9d8f"/>
          <rect x="90" y="215" width="100" height="14" rx="7" fill="#c9d3e0"/>
          <rect x="150" y="60" width="200" height="90" rx="26" fill="#16273d"/>
          <rect x="180" y="90" width="120" height="12" rx="6" fill="#fff"/>
          <rect x="180" y="114" width="80" height="12" rx="6" fill="#2a9d8f"/>
          <circle cx="90" cy="290" r="30" fill="#2a9d8f"/>
          <path d="M76 290l10 10 20-22" stroke="#fff" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>Start with these five guides</h2>
        <p>Read them in order, or jump straight to the one that answers your question.</p>
      </div>
      <div class="grid">
        {guides.map((guide, i) => <GuideCard guide={guide} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section section--card">
    <div class="wrap">
      <div class="section-head"><h2>Why this site is different</h2></div>
      <div class="tiles">
        <div class="tile">
          <div class="ic" aria-hidden="true">👋</div>
          <h3>We assume nothing</h3>
          <p>Every technical word is explained the first time it appears. You'll never feel behind here.</p>
        </div>
        <div class="tile">
          <div class="ic" aria-hidden="true">✅</div>
          <h3>Reviewed by a person</h3>
          <p>Guides are written with AI's help, then read, corrected and approved by a human before publishing. Each page shows the date it was last checked.</p>
        </div>
        <div class="tile">
          <div class="ic" aria-hidden="true">🔓</div>
          <h3>Nothing to buy</h3>
          <p>No account, no app, no newsletter you didn't ask for. Just guides you can read at your own pace.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
