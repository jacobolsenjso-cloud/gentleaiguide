---
// Forsiden: rolig velkomst + de fem guides i anbefalet rækkefølge
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Base
  title="The Gentle AI Guide — plain-English help with AI"
  description="AI explained calmly and in plain English, one small step at a time. No jargon, no hype, no account needed. Written for people who didn't grow up with computers."
>
  <h1>AI, explained gently.</h1>
  <p class="lede">
    Everyone talks about AI. Very few people explain it calmly. This site does —
    in plain English, one small step at a time, with no jargon and no hype.
  </p>
  <p>
    You don't need to be "good with computers" to be here. If you can send an
    email, you can learn to use AI — and decide for yourself what it's good for,
    what it isn't, and what to be careful about.
  </p>

  <h2>Start with these five guides</h2>
  <p>Read them in order, or jump to the one that answers your question.</p>

  {guides.map((guide, i) => (
    <a class="card" href={`/guides/${guide.id}/`}>
      {guide.data.label && <span class="label">{guide.data.label}</span>}
      <h3>{i + 1}. {guide.data.title}</h3>
      <p>{guide.data.description}</p>
    </a>
  ))}

  <h2>What makes this site different</h2>
  <p>
    We assume nothing, we never make you feel behind, and we're honest about
    AI's flaws — including on this site: every guide here is written with the
    help of AI and then read, corrected and approved by a person before it is
    published. That's the working relationship we recommend you have with AI,
    too.
  </p>
</Base>
