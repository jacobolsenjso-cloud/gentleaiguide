---
// Forsiden: ét spørgsmål, én stor knap, derefter de fem guides som trin.
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const first = guides[0];
---
<Base
  title="The Gentle AI Guide — plain-English help with AI"
  description="AI explained calmly and in plain English, one small step at a time. No jargon, no hype, no account needed. Written for people who didn't grow up with computers."
>
  <section class="welcome">
    <div class="wrap">
      <h1>AI, explained gently.</h1>
      <p class="lede">
        Everyone talks about AI. Very few people explain it calmly. This site does —
        one small step at a time, in plain English, with no jargon and no hype.
      </p>
      <p class="question">New to AI? Start here.</p>
      <div class="btn-row" style="margin-top:0.4rem">
        <a class="btn btn--primary btn--big" href={`/guides/${first.id}/`}>Start with guide 1: What is AI?</a>
      </div>
      <p style="margin-top:1.2rem;color:var(--soft)">It takes about 6 minutes to read. There is nothing to sign up for.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top:0">The five guides, in order</h2>
      <p class="read">Read them one after another, or pick the one that answers your question. Each one stands on its own.</p>
      <Steps guides={guides} />
    </div>
  </section>

  <section class="section section--card">
    <div class="wrap read">
      <h2 style="margin-top:0">How this site works</h2>
      <p><strong>Nothing to buy, no account, nothing to install.</strong> You just read.</p>
      <p><strong>Every word is explained</strong> the first time it appears. If you meet a word you don't know, that's our mistake, not yours — <a href="mailto:hello@gentleaiguide.com">tell us</a>.</p>
      <p><strong>A person checks every guide</strong> before it goes online. The guides are written with the help of AI, then read, corrected and approved by a human. Each page shows the date it was last checked.</p>
      <div class="btn-row">
        <a class="btn btn--line" href="/how-to-use/">How to use this site</a>
        <a class="btn btn--line" href="/about/">Who is behind it</a>
      </div>
    </div>
  </section>
</Base>
