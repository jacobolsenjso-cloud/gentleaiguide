---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found — The Gentle AI Guide"
  description="This page doesn't exist. Here's how to find your way back."
>
  <div class="wrap"><div class="prose">
    <h1>That page doesn't exist</h1>
    <p class="lede">Don't worry — you haven't broken anything. This happens to everyone.</p>
    <p>The link you followed may be old, or the address may have a small typo in it.</p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/">Go to the front page</a>
      <a class="btn btn--line" href="/guides/">See the five guides</a>
    </div>
  </div></div>
</Base>
