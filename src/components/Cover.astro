---
// Illustration øverst på hvert guide-kort: en enkel geometrisk figur og et
// stort tal, i sitets dæmpede farver. SVG, så det er skarpt og vejer intet.
interface Props { index: number; }
const { index } = Astro.props;
const n = index + 1;
// Dæmpede grå toner i baggrunden, teal motiv, næsten sort tal
const bg1 = '#f7efe0';
const bg2 = '#eadfc9';
const c1 = '#0f766e';
const c2 = '#a7d3cc';
const num = '#2b2b2b';
const id = `cover-${n}`;
---
<svg class="cover" viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={bg1} /><stop offset="1" stop-color={bg2} />
    </linearGradient>
  </defs>
  <rect width="320" height="200" fill={`url(#${id})`} />
  {index === 0 && <><circle cx="230" cy="95" r="46" fill={c2} /><circle cx="230" cy="95" r="18" fill={c1} /></>}
  {index === 1 && <><rect x="150" y="60" width="150" height="46" rx="23" fill={c2} /><rect x="190" y="118" width="110" height="40" rx="20" fill={c1} opacity="0.55" /></>}
  {index === 2 && <><path d="M230 45l52 20v40c0 34-22 60-52 72-30-12-52-38-52-72V65z" fill={c2} /><path d="M212 108l14 14 26-30" stroke={c1} stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round" /></>}
  {index === 3 && <><circle cx="230" cy="100" r="50" fill={c2} /><path d="M230 72v34" stroke={c1} stroke-width="9" stroke-linecap="round" /><circle cx="230" cy="126" r="6" fill={c1} /></>}
  {index >= 4 && <><rect x="160" y="60" width="38" height="38" rx="9" fill={c2} /><rect x="211" y="60" width="38" height="38" rx="9" fill={c2} /><rect x="262" y="60" width="38" height="38" rx="9" fill={c2} /><rect x="160" y="111" width="38" height="38" rx="9" fill={c2} opacity="0.6" /><rect x="211" y="111" width="38" height="38" rx="9" fill={c1} /><rect x="262" y="111" width="38" height="38" rx="9" fill={c2} opacity="0.6" /></>}
  <text x="28" y="160" font-family="Poppins, sans-serif" font-weight="700" font-size="84" fill={num}>{n}</text>
</svg>
