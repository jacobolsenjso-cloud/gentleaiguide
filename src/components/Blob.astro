---
// Blød farveklat bag en fri figur. Tre former, to farver (svag teal / svag rav),
// valgt ud fra artiklens nummer, så det skifter pænt hen over forsiden.
interface Props { index?: number; }
const { index = 0 } = Astro.props;
const shapes = [
  'M62 18c22-14 60-16 84 4 18 15 26 42 16 64-10 24-40 36-72 34C56 118 22 104 14 78 6 52 32 36 62 18Z',
  'M40 30C60 6 110 4 140 20c26 14 30 46 18 70-12 22-44 34-78 32C46 120 12 100 12 72c0-20 12-32 28-42Z',
  'M30 44C42 16 92 6 126 14c30 8 42 36 34 62-8 28-40 46-76 44C46 118 10 96 12 70c1-10 8-18 18-26Z',
];
const d = shapes[index % shapes.length];
const fill = index % 2 === 0 ? 'var(--accent-soft)' : 'var(--amber-soft)';
---
<svg class="blob" viewBox="0 0 176 130" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path d={d} fill={fill} />
</svg>
