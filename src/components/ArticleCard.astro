---
// Ét artikelkort i tre størrelser:
//   'big'  = stor forsidehistorie (billede, kategori, titel, uddrag, meta)
//   'card' = almindeligt kort i kategorirækkerne
//   'row'  = lille række i "Latest"-spalten (miniature + titel)
import { categoryByName, readingMinutes, formatDate } from '../site';
interface Props { article: any; size?: 'big' | 'card' | 'row'; }
const { article, size = 'card' } = Astro.props;
const cat = categoryByName(article.data.category);
const href = `/guides/${article.id}/`;
const mins = readingMinutes(article.body);
---
{size === 'row' ? (
  <a class="row" href={href}>
    {article.data.image && <img src={article.data.image} alt="" width="200" height="200" loading="lazy" />}
    <span class="row-text">
      {cat && <span class="kicker">{cat.name}</span>}
      <span class="row-title">{article.data.title}</span>
      <span class="row-meta">{formatDate(article.data.updated)} · {mins} min</span>
    </span>
  </a>
) : (
  <article class={`card card--${size}`}>
    <a class="card-img" href={href} tabindex="-1" aria-hidden="true">
      {article.data.image && <img src={article.data.image} alt="" width="1024" height="1024" loading={size === 'big' ? 'eager' : 'lazy'} />}
    </a>
    <div class="card-body">
      {cat && <a class="kicker" href={`/category/${cat.slug}/`}>{cat.name}</a>}
      <h3><a href={href}>{article.data.title}</a></h3>
      {size === 'big' && <p class="card-desc">{article.data.description}</p>}
      <p class="card-meta">{formatDate(article.data.updated)} · {mins} min read · Reviewed by a person</p>
    </div>
  </article>
)}
