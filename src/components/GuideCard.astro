---
// Ét guide-kort: illustration, mærke, titel, uddrag, læsetid og link-linje.
import Cover from './Cover.astro';
interface Props {
  guide: any;   // et element fra getCollection('guides')
  index: number;
}
const { guide, index } = Astro.props;
// Læsetid: ca. 200 ord i minuttet, mindst 1 minut
const words = (guide.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const tag = guide.data.label ?? `Guide ${index + 1}`;
---
<a class="card" href={`/guides/${guide.id}/`}>
  <Cover index={index} />
  <div class="body">
    <span class="tag">{tag}</span>
    <h3>{guide.data.title}</h3>
    <p>{guide.data.description}</p>
    <span class="meta">Reviewed by a person · {minutes} min read</span>
    <span class="more">Read the guide →</span>
  </div>
</a>
