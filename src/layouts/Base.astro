---
import { INDEXABLE } from '../site';
// Fælles layout: head, navigation, footer og al global CSS.
// "Guidet sti": én spalte, ét emne ad gangen, store knapper med bogstavelig
// tekst, ingen pynt. Bygget efter W3C's anbefalinger for ældre brugere:
// stor skrift, høj kontrast, tydelig "hvor er jeg", få klik, ingen bevægelse.
// Farver: creme baggrund, kulsort tekst, rav KUN til den vigtigste knap,
// teal til links.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/guides/', label: 'The five guides' },
  { href: '/how-to-use/', label: 'How to use this site' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" />
  <script is:inline>
    // Husk læserens valgte tekststørrelse, før siden tegnes (undgår "hop").
    try {
      var s = localStorage.getItem('textsize');
      if (s === 'large' || s === 'larger') document.documentElement.setAttribute('data-textsize', s);
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header>
    <div class="wrap topbar">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="10" fill="var(--accent)"/><path d="M15 27v-9h2v9h-2Zm1-9c-.4-6-3.4-9.6-9.5-11 .9 6.5 4 9.9 9.5 11Zm0 0c.4-6 3.4-9.6 9.5-11-.9 6.5-4 9.9-9.5 11Z" fill="#fff"/></svg>
        <span>The Gentle AI Guide</span>
      </a>
      <div class="textsize" role="group" aria-label="Text size">
        <span class="textsize-label">Text size:</span>
        <button type="button" data-size="normal" aria-pressed="true">A</button>
        <button type="button" data-size="large" aria-pressed="false">A<span aria-hidden="true">+</span><span class="sr">larger</span></button>
        <button type="button" data-size="larger" aria-pressed="false">A<span aria-hidden="true">++</span><span class="sr">largest</span></button>
      </div>
    </div>
    <nav class="wrap" aria-label="Main">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={current === item.href || (item.href !== '/' && current.startsWith(item.href)) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <p class="footer-brand">The Gentle AI Guide</p>
      <p>Plain-English help with AI, at your own pace. Every guide is read and approved by a person before it is published.</p>
      <p>Nothing to buy. No account. Nothing to install.</p>
      <p class="footer-links">
        <a href="/guides/">The five guides</a> ·
        <a href="/how-to-use/">How to use this site</a> ·
        <a href="/about/">About</a> ·
        <a href="mailto:hello@gentleaiguide.com">hello@gentleaiguide.com</a>
      </p>
    </div>
  </footer>

  <script is:inline>
    // Tekststørrelse-knapperne: sæt attribut på <html>, gem valget.
    (function () {
      var root = document.documentElement;
      var buttons = document.querySelectorAll('.textsize button');
      function apply(size) {
        if (size === 'normal') root.removeAttribute('data-textsize');
        else root.setAttribute('data-textsize', size);
        buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.size === size)); });
        try { localStorage.setItem('textsize', size); } catch (e) {}
      }
      var current = root.getAttribute('data-textsize') || 'normal';
      buttons.forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.size === current));
        b.addEventListener('click', function () { apply(b.dataset.size); });
      });
    })();
  </script>

  <style is:global>
    :root {
      --w: 60rem;               /* 960 px: bred nok til computer, én spalte */
      --read: 46rem;            /* læsespalte ≈ 65-75 tegn pr. linje */
      --paper: #fbf7ef;
      --paper2: #f3ecdf;
      --card: #ffffff;
      --ink: #2b2b2b;
      --soft: #55554f;
      --line: #e3dccd;
      --accent: #0f766e;
      --accent-soft: #dcefec;
      --amber: #b45309;
      --amber-hover: #92400e;
      --focus: #b45309;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #17150f; --paper2: #1d1a13; --card: #221f18;
        --ink: #f1ede4; --soft: #c2bcb0; --line: #37332b;
        --accent: #4cc2b2; --accent-soft: #1f3a36;
        --amber: #d97706; --amber-hover: #f59e0b; --focus: #ffb25e;
      }
    }
    /* Tekststørrelse: alt er sat i rem, så én regel skalerer hele sitet */
    html { font-size: 100%; }
    html[data-textsize='large'] { font-size: 112.5%; }
    html[data-textsize='larger'] { font-size: 125%; }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: 'Atkinson Hyperlegible', Verdana, sans-serif;
      font-size: 1.1875rem; /* 19 px ved normal størrelse */
      line-height: 1.7;
    }
    h1, h2, h3 { font-family: 'Poppins', 'Segoe UI', sans-serif; font-weight: 700; line-height: 1.18; letter-spacing: -0.015em; text-wrap: balance; color: var(--ink); margin: 0; }
    h1 { font-size: 2.6rem; }
    h2 { font-size: 1.8rem; margin-top: 2.4rem; }
    h3 { font-size: 1.3rem; margin-top: 1.6rem; }
    p { margin: 0.9rem 0; }
    a { color: var(--accent); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
    a:hover { text-decoration-thickness: 3px; }
    :focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; border-radius: 6px; }
    .sr { position: absolute; left: -9999px; }
    .skip { position: absolute; left: -999px; top: 0; background: var(--card); padding: 0.6rem 1rem; z-index: 20; }
    .skip:focus { left: 0.5rem; top: 0.5rem; }
    .wrap { max-width: var(--w); margin: 0 auto; padding: 0 1.5rem; }

    /* ---------- Header: mærke + tekststørrelse, derunder menu ---------- */
    header { background: var(--card); border-bottom: 2px solid var(--line); }
    .topbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1rem; padding-bottom: 0.6rem; flex-wrap: wrap; }
    .brand { display: flex; align-items: center; gap: 0.7rem; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.3rem; color: var(--ink); text-decoration: none; }
    .brand-mark { width: 2.4rem; height: 2.4rem; flex: none; }
    .textsize { display: flex; align-items: center; gap: 0.35rem; }
    .textsize-label { font-size: 1rem; color: var(--soft); margin-right: 0.3rem; }
    .textsize button {
      font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1rem; line-height: 1;
      min-width: 2.9rem; height: 2.9rem; padding: 0 0.6rem; border-radius: 0.6rem;
      border: 2px solid var(--line); background: var(--card); color: var(--ink); cursor: pointer;
    }
    .textsize button[aria-pressed='true'] { background: var(--ink); color: var(--card); border-color: var(--ink); }
    nav ul { display: flex; gap: 0.4rem; list-style: none; margin: 0; padding: 0.3rem 0 0; flex-wrap: wrap; }
    nav ul a {
      display: inline-block; padding: 0.75rem 1.1rem; border-radius: 0.7rem 0.7rem 0 0;
      font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 1.05rem;
      text-decoration: none; color: var(--ink); border-bottom: 4px solid transparent;
    }
    nav ul a:hover { background: var(--paper); }
    nav ul a[aria-current='page'] { border-bottom-color: var(--accent); color: var(--accent); }

    /* ---------- Knapper: store, bogstavelige ---------- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
      font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.15rem; line-height: 1.25;
      padding: 1.05rem 1.7rem; border-radius: 0.8rem; text-decoration: none;
      border: 3px solid transparent; min-height: 3.5rem;
    }
    .btn:hover { text-decoration: none; }
    .btn--primary { background: var(--amber); color: #fff; }
    .btn--primary:hover { background: var(--amber-hover); }
    .btn--line { background: var(--card); color: var(--ink); border-color: var(--ink); }
    .btn--line:hover { background: var(--paper2); }
    .btn--big { font-size: 1.3rem; padding: 1.2rem 2rem; }
    .btn-row { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.6rem; }

    /* ---------- Sektioner ---------- */
    .section { padding: 3rem 0; }
    .section--card { background: var(--card); border-top: 2px solid var(--line); border-bottom: 2px solid var(--line); }
    .label { font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 1.05rem; color: var(--accent); margin: 0 0 0.6rem; }
    .lede { font-size: 1.3rem; line-height: 1.6; color: var(--soft); margin: 1rem 0 0; max-width: var(--read); }
    .read { max-width: var(--read); }

    /* ---------- Velkomst ---------- */
    .welcome { padding: 3.2rem 0 2.8rem; background: var(--card); border-bottom: 2px solid var(--line); }
    .welcome h1 { font-size: 2.9rem; max-width: 40rem; }
    .welcome .question { font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 1.35rem; margin: 1.8rem 0 0.6rem; }

    /* ---------- Trin-liste (de fem guides) ---------- */
    .steps { list-style: none; margin: 1.6rem 0 0; padding: 0; counter-reset: step; }
    .step {
      counter-increment: step; display: grid; grid-template-columns: 4rem 1fr; gap: 1.2rem;
      background: var(--card); border: 2px solid var(--line); border-radius: 1rem;
      padding: 1.5rem 1.6rem; margin: 1rem 0;
    }
    .step::before {
      content: counter(step); font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.6rem;
      width: 4rem; height: 4rem; border-radius: 50%; background: var(--accent-soft); color: var(--accent);
      display: grid; place-items: center; align-self: start;
    }
    .step h3 { margin: 0.3rem 0 0.4rem; font-size: 1.45rem; }
    .step h3 a { color: var(--ink); }
    .step p { margin: 0 0 1rem; color: var(--soft); }
    .step .btn { align-self: start; }
    .step--first { border-color: var(--amber); border-width: 3px; }
    .step--first::before { background: var(--amber); color: #fff; }

    /* ---------- Hvor er jeg: "Guide 2 of 5" + fremdrift ---------- */
    .progress { margin: 0 0 1.2rem; }
    .progress p { font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 1.05rem; margin: 0 0 0.5rem; color: var(--accent); }
    .progress-bar { height: 0.7rem; background: var(--line); border-radius: 999px; overflow: hidden; max-width: 24rem; }
    .progress-bar span { display: block; height: 100%; background: var(--accent); border-radius: 999px; }

    /* ---------- Artikel ---------- */
    .page-top { background: var(--card); border-bottom: 2px solid var(--line); padding: 2.6rem 0 2.4rem; }
    .page-top h1 { max-width: var(--read); }
    .prose { max-width: var(--read); padding: 2.4rem 0 1rem; }
    .prose ul, .prose ol { padding-left: 1.5rem; }
    .prose li { margin: 0.6rem 0; }
    .prose blockquote { margin: 1.5rem 0; padding: 1rem 1.4rem; border-left: 5px solid var(--accent); background: var(--card); border-radius: 0 0.8rem 0.8rem 0; color: var(--soft); }
    .prose code { background: var(--accent-soft); padding: 0.1rem 0.45rem; border-radius: 6px; font-size: 0.95em; }
    .prose hr { border: none; border-top: 2px solid var(--line); margin: 2.4rem 0; }
    .updated { color: var(--soft); font-size: 1rem; margin: 0 0 1.4rem; }

    /* ---------- Forrige / Næste ---------- */
    .pager { max-width: var(--read); display: grid; gap: 1rem; margin: 2rem 0 3.5rem; }
    .pager a {
      display: block; text-decoration: none; color: var(--ink); background: var(--card);
      border: 3px solid var(--line); border-radius: 1rem; padding: 1.2rem 1.5rem;
    }
    .pager a:hover { border-color: var(--accent); }
    .pager a.next { border-color: var(--amber); }
    .pager small { display: block; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 1rem; color: var(--accent); margin-bottom: 0.2rem; }
    .pager a.next small { color: var(--amber); }
    .pager strong { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.2rem; }
    @media (min-width: 40rem) { .pager { grid-template-columns: 1fr 1fr; } }

    /* ---------- Footer ---------- */
    footer { background: var(--card); border-top: 2px solid var(--line); color: var(--soft); padding: 2.6rem 0; }
    footer p { margin: 0.4rem 0; font-size: 1.02rem; max-width: var(--read); }
    footer a { color: var(--ink); }
    .footer-brand { font-family: 'Poppins', sans-serif; font-weight: 700; color: var(--ink); font-size: 1.15rem; }
    .footer-links { margin-top: 1rem; }

    @media (max-width: 40rem) {
      h1, .welcome h1 { font-size: 2.1rem; }
      h2 { font-size: 1.55rem; }
      .lede { font-size: 1.15rem; }
      .btn, .step .btn { width: 100%; }
      .step { grid-template-columns: 3rem 1fr; gap: 0.9rem; padding: 1.2rem 1.1rem; }
      .step::before { width: 3rem; height: 3rem; font-size: 1.3rem; }
      .section, .welcome { padding: 2.2rem 0; }
      .textsize-label { display: none; }
    }
  </style>
</body>
</html>
