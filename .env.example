# Kopiér denne fil til .env og udfyld. Ingen af nøglerne kommer på GitHub.

# Udbyder: cloudflare (gratis daglig kvote) eller gemini
IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI — token laves på https://dash.cloudflare.com/profile/api-tokens
# (vælg skabelonen "Workers AI"). Konto-ID står i Cloudflare-dashboardets adresselinje.
CF_ACCOUNT_ID=34f0e1dc54050e97066f335a6911c54f
CF_API_TOKEN=

# Google Gemini (kun hvis du har betalt kvote)
GEMINI_API_KEY=
